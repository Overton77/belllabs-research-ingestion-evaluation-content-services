  "sdl": "type Biomarker implements Entity & SearchIndexable @node @fulltext(indexes: [{indexName: \"BiomarkerSearch\", fields: [\"name\", \"description\", \"searchText\"], queryName: \"searchBiomarkers\"}]) {\n  id: ID! @id\n  name: String!\n  description: String\n  mongoResearchRunId: String\n  createdAt: DateTime! @timestamp(operations: [CREATE])\n  updatedAt: DateTime! @timestamp(operations: [CREATE, UPDATE])\n  searchText: String\n  searchFields: [String!]\n  embeddingModel: String\n  embeddingDimensions: Int\n  biomarkerType: String\n  specimenMatrix: String\n  moleculeClass: String\n  measurementDirectness: String\n  clinicalSignificance: String\n  commonUnits: [String!]\n  agingHallmark: String\n  searchEmbedding: [Float!]\n  indicatesConditions: [Condition!]! @relationship(type: \"INDICATES\", direction: OUT, properties: \"AssociationMetadata\")\n  reflectsMechanisms: [Mechanism!]! @relationship(type: \"REFLECTS_MECHANISM\", direction: OUT, properties: \"MechanismLinkMetadata\")\n  inPathways: [Pathway!]! @relationship(type: \"IN_PATHWAY\", direction: OUT, properties: \"AssociationMetadata\")\n  expressedInOrgans: [Organ!]! @relationship(type: \"EXPRESSED_IN\", direction: OUT, properties: \"AssociationMetadata\")\n  expressedInContexts: [AnatomicalContext!]! @relationship(type: \"EXPRESSED_IN_CONTEXT\", direction: OUT, properties: \"AssociationMetadata\")\n  encodedByGenes: [MolecularEntity!]! @relationship(type: \"ENCODES\", direction: IN, properties: \"AssociationMetadata\")\n  hasReferenceRanges: [ReferenceRange!]! @relationship(type: \"HAS_REFERENCE_RANGE\", direction: OUT, properties: \"AssociationMetadata\")\n  supportedBy: [Chunk!]! @relationship(type: \"SUPPORTED_BY\", direction: OUT, properties: \"ExtractionMetadata\")\n}",
