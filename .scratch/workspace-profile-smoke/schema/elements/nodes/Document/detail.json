  "sdl": "type Document implements Entity & SearchIndexable @node @fulltext(indexes: [{indexName: \"DocumentSearch\", fields: [\"name\", \"sourceUrl\", \"searchText\"], queryName: \"searchDocuments\"}]) @vector(indexes: [{indexName: \"DocumentSearchEmbedding\", provider: OPEN_AI, embeddingProperty: \"searchEmbedding\", queryName: \"searchDocumentsBySemanticText\"}]) {\n  id: ID! @id @alias(property: \"documentId\")\n  name: String! @alias(property: \"title\")\n  description: String\n  mongoResearchRunId: String\n  createdAt: DateTime! @timestamp(operations: [CREATE])\n  updatedAt: DateTime! @timestamp(operations: [CREATE, UPDATE])\n  searchText: String\n  searchFields: [String!]\n  embeddingModel: String\n  embeddingDimensions: Int\n  documentKey: String!\n  documentType: DocumentType! @alias(property: \"type\")\n  sourceUrl: String @alias(property: \"url\")\n  documentDomain: DocumentDomain\n  publisher: String\n  publicationVenue: String\n  publishedAt: DateTime\n  fileFormat: String\n  languageCode: String\n  isPeerReviewed: Boolean\n  isPrimarySource: Boolean\n  isRegulatorySource: Boolean\n  isFinancialDisclosure: Boolean\n  searchEmbedding: [Float!]\n  hasTextVersions: [DocumentTextVersion!]! @relationship(type: \"HAS_TEXT_VERSION\", direction: OUT)\n  hasChunks: [Chunk!]! @relationship(type: \"HAS_CHUNK\", direction: OUT, properties: \"OrderingMetadata\")\n  about: [ClaimSubject!]! @relationship(type: \"ABOUT\", direction: OUT, properties: \"ExtractionMetadata\")\n  authoredBy: [DocumentAuthor!]! @relationship(type: \"AUTHORED_BY\", direction: OUT, properties: \"RoleMetadata\")\n  sourceForEpisodes: [Episode!]! @relationship(type: \"SOURCE_OF\", direction: OUT, properties: \"RoleMetadata\")\n}",
