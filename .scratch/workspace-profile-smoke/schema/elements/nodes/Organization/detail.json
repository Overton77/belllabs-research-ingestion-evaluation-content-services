  "sdl": "type Organization implements Entity & SearchIndexable @node @fulltext(indexes: [{indexName: \"OrganizationName\", fields: [\"name\", \"searchText\", \"legalName\", \"displayName\", \"canonicalTicker\"], queryName: \"searchOrganizationsByName\"}]) @vector(indexes: [{indexName: \"OrganizationSearchEmbedding\", provider: OPEN_AI, embeddingProperty: \"searchEmbedding\", queryName: \"searchOrganizationsBySemanticText\"}]) {\n  id: ID! @id\n  name: String!\n  description: String\n  mongoResearchRunId: String\n  createdAt: DateTime! @timestamp(operations: [CREATE])\n  updatedAt: DateTime! @timestamp(operations: [CREATE, UPDATE])\n  searchText: String\n  searchFields: [String!]\n  embeddingModel: String\n  embeddingDimensions: Int\n  canonicalTicker: String\n  legalName: String\n  displayName: String\n  organizationType: OrganizationType\n  active: Boolean\n  incorporatedOn: DateTime\n  dissolvedOn: DateTime\n  operatingFrom: DateTime\n  operatingTo: DateTime\n  foundedYear: Int\n  fundingStage: FundingStage\n  totalFundingUsd: Float\n  employeeCountMin: Int\n  employeeCountMax: Int\n  employeeCountEstimate: Int\n  employeeCountBand: EmployeeCountBand\n  employeeCountRaw: String\n  revenueModel: String\n  valueChainStages: [String!]\n  sector: String\n  websiteUrl: String\n  headquartersSummary: String\n  operatingSummary: String\n  marketCapUsd: Float\n  pipelineSummary: String\n  competitivePositionSummary: String\n  isPublicCompany: Boolean\n  isInvestor: Boolean\n  isProviderOrganization: Boolean\n  isResearchOrganization: Boolean\n  isManufacturer: Boolean\n  \"\"\"Marks the timestamp of the current materialized state on this node.\"\"\"\n  currentAsOf: DateTime\n  \"\"\"\n  Canonical semantic search embedding for the organization identity/current record.\n  \"\"\"\n  searchEmbedding: [Float!]\n  \"\"\"\n  Optional historical milestone snapshots.\n  Non-temporal linkage only.\n  \"\"\"\n  snapshots: [OrganizationSnapshot!]! @relationship(type: \"HAS_SNAPSHOT\