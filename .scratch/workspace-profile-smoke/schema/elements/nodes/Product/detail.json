  "sdl": "type Product implements Entity & SearchIndexable @node @fulltext(indexes: [{indexName: \"ProductSearch\", fields: [\"name\", \"description\", \"searchText\", \"productType\", \"productClass\", \"primaryRegulatoryIdentifier\", \"regulatoryAuthorizationId\"], queryName: \"searchProducts\"}]) @vector(indexes: [{indexName: \"ProductSearchEmbedding\", provider: OPEN_AI, embeddingProperty: \"searchEmbedding\", queryName: \"searchProductsBySemanticText\"}]) {\n  id: ID! @id\n  name: String!\n  description: String\n  mongoResearchRunId: String\n  createdAt: DateTime! @timestamp(operations: [CREATE])\n  updatedAt: DateTime! @timestamp(operations: [CREATE, UPDATE])\n  searchText: String\n  searchFields: [String!]\n  embeddingModel: String\n  embeddingDimensions: Int\n  \"\"\"\n  Stable identity-level or canonical product identifier.\n  Keep only if truly stable.\n  \"\"\"\n  primaryRegulatoryIdentifier: String\n  \"\"\"Current materialized product facts.\"\"\"\n  productType: String\n  applicationContext: String\n  categories: [String!]\n  launchYear: Int\n  targetCustomer: String\n  deliveryModel: String\n  status: ProductStatus\n  approvedYear: Int\n  productClass: String\n  formulationSummary: String\n  indicationSummary: String\n  modalitySummary: String\n  regulatoryAuthorizationId: String\n  \"\"\"Timestamp for the current materialized product record.\"\"\"\n  currentAsOf: DateTime\n  \"\"\"Canonical semantic search embedding for the product current record.\"\"\"\n  searchEmbedding: [Float!]\n  \"\"\"Optional historical product snapshots.\"\"\"\n  snapshots: [ProductSnapshot!]! @relationship(type: \"HAS_SNAPSHOT\", direction: OUT)\n  offeredBy: [Organization!]! @relationship(type: \"OFFERS\", direction: IN, properties: \"RoleMetadata\")\n  manufacturedBy: [Organization!]! @relationship(type: \"MANUFACTURES\", direction: IN, properties: \"RoleMetadata\")\n  contractManufacturedBy: [Organization!]! @relationship(type: \"CONTRACTS_MANUFACTURING\", direction: IN, 