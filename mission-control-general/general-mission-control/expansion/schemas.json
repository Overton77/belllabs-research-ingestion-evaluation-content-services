        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1
        },
        "expiry": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "budget_id",
        "scope",
        "actor_ref",
        "target_refs",
        "profile_refs",
        "currency",
        "dimensions",
        "reserved_micros",
        "max_concurrency",
        "stop_conditions",
        "authorization_ref",
        "expiry"
