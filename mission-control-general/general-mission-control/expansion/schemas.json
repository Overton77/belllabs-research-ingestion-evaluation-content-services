        "actor_ref": {
          "type": "string",
          "minLength": 1
        },
        "native_event_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "MissionEvent": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mc.event.v1"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "mission_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "ledger_commit_id": {
          "type": "string",
          "format": "uuid"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "event_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "execution": {
          "$ref": "#/$defs/EventExecution"
        },
        "source": {
          "$ref": "#/$defs/EventSource"
        },
        "causation_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "payload_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "scope",
        "mission_id",
        "seq",
        "ledger_commit_id",
        "occurred_at",
        "recorded_at",
        "event_type",
        "event_version",
        "execution",
        "source",
        "payload_ref"
      ],
      "additionalProperties": false
    },
    "StreamFrame": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "mc.stream_frame.v1"
            },
            "type": {
              "const": "event"
            },
            "event": {
              "$ref": "#/$defs/MissionEvent"
            }
          },
          "required": [
            "schema",
            "type",
            "event"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "mc.stream_frame.v1"
            },
            "type": {
              "const": "heartbeat"
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "schema",
            "type",
            "recorded_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "mc.stream_frame.v1"
            },
            "type": {
              "const": "resync_required"
            },
            "mission_id": {
              "type": "string",
              "format": "uuid"
            },
            "retained_floor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "snapshot_ref": {
              "type": "string",
              "minLength": 1
            },
            "snapshot_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "code": {
              "const": "CURSOR_EXPIRED"
            }
          },
          "required": [
            "schema",
            "type",
            "mission_id",
            "retained_floor",
            "snapshot_ref",
            "snapshot_seq",
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "mc.stream_frame.v1"
            },
            "type": {
              "const": "auth_expiring"
            },
            "reconnect_required": {
              "const": true
            }
          },
          "required": [
            "schema",
            "type",
            "reconnect_required"
          ],
          "additionalProperties": false
        }
      ]
    },
    "InterviewCreate": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mc.interview_create.v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "draft_ref": {
          "type": "string",
          "minLength": 1
        },
        "environment_profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "admitted_agent_config_ref": {
          "type": "string",
          "minLength": 1
        },
        "initial_message_ref": {
          "type": "string",
          "minLength": 1
        },
        "context_request_ref": {
          "type": "string",
          "minLength": 1
        },
        "budget_profile_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "tenant_id",
        "environment_profile_ref",
        "admitted_agent_config_ref",
        "initial_message_ref",
        "context_request_ref",
        "budget_profile_ref"
      ],
      "additionalProperties": false
    },
    "ReviewDecision": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mc.review_decision.v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "human_task_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_task_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "target_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "decision": {
          "enum": [
            "approve",
            "reject",
            "request_changes",
            "abstain"
          ]
        },
        "feedback_ref": {
          "type": "string",
          "minLength": 1
        },
        "selected_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "human_task_id",
        "expected_task_version",
        "target_digest",
        "decision",
        "selected_evidence_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "enum": [
                  "reject",
                  "request_changes"
                ]
              }
            }
          },
          "then": {
            "required": [
              "feedback_ref"
            ]
          }
        }
      ]
    }
  }
}
