      "required": [
        "schema_version",
        "request_id",
        "scope",
        "run_id",
        "activation_id",
        "attempt_id",
        "generation",
        "operation",
        "capability_ref",
        "executor_digest",
        "input_manifest",
        "native_schema_ref",
        "native_payload_digest",
        "effect_key",
        "precondition_manifest",
        "approval_refs",
        "admission_ref",
        "governor_profile_ref"
      ],
      "additionalProperties": false
    },
