{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mc:expansion:v1",
  "$defs": {
    "Scope": {
      "type": "object",
      "properties": {
        "installation_id": {
          "type": "string",
          "format": "uuid"
        },
        "application_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "installation_id",
        "application_id",
        "tenant_id"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "resource_id",
        "scope",
        "issuer",
        "schema_ref",
        "digest"
      ],
      "additionalProperties": false
    },
    "ContextItem": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "token_bound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "trust": {
          "enum": [
            "untrusted_source",
            "admitted_evidence",
            "operating_contract",
            "advisory_memory"
          ]
        }
      },
      "required": [
        "artifact",
        "locator",
        "token_bound",
        "trust"
      ],
      "additionalProperties": false
    },
    "Omission": {
      "type": "object",
      "properties": {
        "candidate_ref": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            "budget",
            "not_authorized",
            "expired",
            "duplicate",
            "irrelevant",
            "unqualified"
          ]
        }
      },
      "required": [
        "candidate_ref",
        "reason"
      ],
      "additionalProperties": false
    },
    "ContextSelection": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mc.context_selection.v1"
        },
        "selection_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "tokenizer_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_capture_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "selected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextItem"
          }
        },
        "omitted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Omission"
          }
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "total_token_bound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "file_manifest_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "grants_snapshot_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "selection_id",
        "request_id",
        "scope",
        "target_ref",
        "purpose",
        "policy_ref",
        "tokenizer_ref",
        "candidate_capture_refs",
        "selected",
        "omitted",
        "max_input_tokens",
        "total_token_bound",
        "file_manifest_ref",
        "grants_snapshot_ref"
      ],
      "additionalProperties": false
    },
    "StateHandoff": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mc.state_handoff.v1"
        },
        "handoff_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
