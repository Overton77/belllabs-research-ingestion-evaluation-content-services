        "producer_attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "producer_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "base_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "delta": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "journal_through_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "liability_manifest_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "state_schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "admission_decision_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "handoff_id",
        "scope",
        "producer_attempt_id",
        "producer_generation",
        "target_ref",
        "base_version",
        "base_digest",
        "revision_digest",
        "binding_digest",
        "input_digest",
        "delta",
        "outputs",
        "journal_through_seq",
        "liability_manifest_ref",
        "state_schema_ref",
        "admission_decision_ref"
      ],
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mc.message.v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sender_ref": {
          "type": "string",
          "minLength": 1
        },
        "client_message_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "instruction",
            "context",
            "progress",
            "question",
            "answer",
            "result"
          ]
        },
        "boundary": {
          "enum": [
            "next_turn",
            "next_iteration",
            "after_checkpoint"
          ]
        },
        "content": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "scope",
        "target_ref",
        "target_generation",
        "sender_ref",
        "client_message_id",
        "kind",
        "boundary",
        "content",
        "deadline"
      ],
      "additionalProperties": false
    },
    "Progress": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mc.progress.v1"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "summary": {
          "type": "string",
          "maxLength": 4096
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "remaining": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocker_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "usage_disposition": {
          "enum": [
            "settled",
            "estimated",
            "unknown"
          ]
        },
        "journal_through_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "schema_version",
        "scope",
        "attempt_id",
        "generation",
        "summary",
        "completed",
        "remaining",
        "blocker_refs",
        "outputs",
        "usage_disposition",
        "journal_through_seq"
      ],
      "additionalProperties": false
    },
    "PriceDimension": {
      "type": "object",
