{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": ["."],
  "graphs": {},
  "env": ".env",
  "auth": {
    "path": "app.agent_server.auth:auth",
    "disable_studio_auth": false,
    "openapi": {
      "securitySchemes": {
        "belllabsBearer": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
      },
      "security": [
        {
          "belllabsBearer": []
        }
      ]
    }
  },
  "http": {
    "app": "app.agent_server.http_app:app",
    "middleware_order": "auth_first"
  },
  "python_version": "3.12"
}
