{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py after_compaction mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py after_tool mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py after_shell mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py after_file_edit mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "apply_patch"
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py after_tool mc.usage",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_compaction mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_tool mc.stop_fence",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_shell mc.stop_fence",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_mcp mc.stop_fence",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "mcp__.*"
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_tool mc.operation_intent",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_shell mc.operation_intent",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_mcp mc.operation_intent",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "mcp__.*"
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_tool mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_shell mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_mcp mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "mcp__.*"
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/run.py hook.mc-policy-template before_shell",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/run.py hook.mc-policy-template before_tool",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py session_end mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py session_start mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/run.py hook.mc-policy-template session_start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py stop mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py stop mc.usage",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py subagent_start mc.stop_fence",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py subagent_start mc.operation_intent",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py subagent_start mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py subagent_stop mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python .mission/hooks/kernel.py before_prompt mc.frame_capture",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
