{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              ".mission/hooks/run.py",
              "hook.mc-policy-template",
              "before_shell"
            ],
            "command": "python",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "args": [
              ".mission/hooks/run.py",
              "hook.mc-policy-template",
              "before_tool"
            ],
            "command": "python",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              ".mission/hooks/run.py",
              "hook.mc-policy-template",
              "session_start"
            ],
            "command": "python",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
