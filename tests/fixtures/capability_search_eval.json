{
  "schema_version": "mc.capability_search_eval.v1",
  "description": "Fixed evaluation set for capability search over the seeded catalog (SPEC-01 Hybrid search, FT-A3). A case passes when any expected id is in the top 3; ids in 'excluded' must never appear. Recall@3 must stay >= 0.9 in lexical mode (unit) and hybrid mode (common_db).",
  "minimum_recall_at_3": 0.9,
  "queries": [
    {"query": "pubmed literature retrieval", "expected": ["mcp.pubmed"], "kinds": ["mcp_server"]},
    {"query": "web search", "expected": ["mcp.tavily", "mcp.firecrawl"], "kinds": ["mcp_server"]},
    {"query": "sec filings", "expected": ["mcp.edgartools"], "kinds": ["mcp_server"]},
    {"query": "browser automation click fill", "expected": ["mcp.agent-browser"], "kinds": ["mcp_server"]},
    {"query": "tavily_search", "expected": ["mcp.tavily.tool.tavily-search"]},
    {"query": "edgar_company", "expected": ["mcp.edgartools.tool.edgar-company"]},
    {"query": "scrape a page to markdown", "expected": ["mcp.firecrawl.tool.firecrawl-scrape", "mcp.firecrawl"]},
    {"query": "MeSH descriptors lookup", "expected": ["mcp.pubmed.tool.pubmed-lookup-mesh"]},
    {"query": "format citations BibTeX", "expected": ["mcp.pubmed.tool.pubmed-format-citations"]},
    {"query": "clinical trials variants genes", "expected": ["mcp.biomcp"], "kinds": ["mcp_server"]},
    {"query": "insider institutional ownership", "expected": ["mcp.edgartools.tool.edgar-ownership"]},
    {"query": "crawl a website from a root URL", "expected": ["mcp.firecrawl.tool.firecrawl-crawl", "mcp.tavily.tool.tavily-crawl"]},
    {"query": "site URL structure map", "expected": ["mcp.tavily.tool.tavily-map", "mcp.firecrawl.tool.firecrawl-map"]},
    {"query": "research paper index bioRxiv arXiv", "expected": ["mcp.firecrawl.tool.firecrawl-research-search-papers", "mcp.firecrawl"]},
    {"query": "accessibility snapshot element refs", "expected": ["mcp.agent-browser.tool.agent-browser-snapshot"]},
    {"query": "capture a screenshot", "expected": ["mcp.agent-browser.tool.agent-browser-screenshot"]},
    {"query": "convert DOI PMID PMCID", "expected": ["mcp.pubmed.tool.pubmed-convert-ids"]},
    {"query": "article full text by PMID", "expected": ["mcp.pubmed.tool.pubmed-fetch-fulltext"]},
    {"query": "XBRL time series growth", "expected": ["mcp.edgartools.tool.edgar-trends"]},
    {"query": "executive compensation proxy", "expected": ["mcp.edgartools.tool.edgar-proxy"]},
    {"query": "scheduled change monitor", "expected": ["mcp.firecrawl.tool.firecrawl-monitor-create", "mcp.firecrawl.tool.firecrawl-monitor-list", "mcp.firecrawl.tool.firecrawl-monitor-run"]},
    {"query": "regulatory law index", "expected": ["mcp.firecrawl.tool.firecrawl-gov-search"]},
    {"query": "mission control coordinator", "expected": ["skill.mission-control-coordinator"], "kinds": ["skill"]},
    {"query": "propose governed workflow", "expected": ["prompt.coordinator.propose-workflow"], "kinds": ["prompt"]},
    {"query": "generic stage graph", "expected": ["fixture.generic-stage-graph"], "kinds": ["blueprint"]},
    {"query": "generic goal directed", "expected": ["fixture.generic-goal-directed"], "kinds": ["blueprint"]},
    {"query": "Europe PMC preprints search", "expected": ["mcp.pubmed.tool.pubmed-europepmc-search"]},
    {"query": "ClinGen variant evidence", "expected": ["mcp.biomcp.tool.variant-erepo", "mcp.biomcp.tool.variant-normalize-car"]},
    {"query": "EDGAR full-text search", "expected": ["mcp.edgartools.tool.edgar-text-search"]},
    {"query": "credit usage", "expected": ["mcp.firecrawl.tool.firecrawl-credit-usage"]},
    {"query": "literature papers", "expected": ["mcp.firecrawl"], "kinds": ["mcp_server"], "host_profiles": ["cursor_cloud"], "excluded": ["mcp.pubmed", "mcp.biomcp"]},
    {"query": "browser", "expected": ["mcp.firecrawl"], "kinds": ["mcp_server"], "host_profiles": ["cursor_cloud"], "excluded": ["mcp.agent-browser"]},
    {"query": "web search read only", "expected": ["mcp.tavily.tool.tavily-search", "mcp.firecrawl.tool.firecrawl-search"], "side_effect_classes": ["read_only"], "excluded": ["mcp.firecrawl.tool.firecrawl-interact"]}
  ]
}
