{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": ["."],
  "graphs": {
    "block_c_qualification_n1": "app.agent_server.block_c_qualification.graph_n1:graph"
  },
  "env": "langgraph.block_c.env",
  "auth": {
    "path": "app.agent_server.block_c_qualification.auth:auth",
    "disable_studio_auth": true,
    "openapi": {
      "securitySchemes": {
        "belllabsBearer": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
      },
      "security": [
        {
          "belllabsBearer": []
        }
      ]
    }
  },
  "http": {
    "app": "app.agent_server.block_c_qualification.http_app:app",
    "middleware_order": "auth_first"
  },
  "python_version": "3.12"
}
